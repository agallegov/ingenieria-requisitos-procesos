{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingenieria-requisitos/planos/v3",
  "title": "planos.json (v3): planificación empresarial",
  "description": "Única fuente estructurada de la planificación de procesos y estructuras empresariales. Se usa para mapear procesos, definir estructuras organizativas, registrar cumplimiento legal/fiscal, planificar presupuestos y distribuir entregables. Los ids A-n, ENT-n, C-n, G-n, Q-n, U-n, R-n, PROV-n y SUP-n son ÚNICOS EN TODO EL PROYECTO.",
  "type": "object",
  "required": ["version", "titulo"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 3 },
    "proyecto": { "type": "string", "description": "Slug del proyecto." },
    "titulo": { "type": "string", "minLength": 1 },
    "descripcion": { "type": "string", "description": "Dos o tres frases en palabras del negocio: qué se quiere planificar y para qué sirve este documento." },
    "definicion": {
      "type": "object",
      "required": ["estado", "modo"],
      "additionalProperties": false,
      "properties": {
        "estado": { "enum": ["borrador", "listo para revisar", "aprobado", "congelado"] },
        "modo": { "enum": ["entrevista", "documentacion", "experto"] },
        "bloques_no_aplican": { "type": "array", "items": { "type": "string" } },
        "supuestos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "texto", "origen", "estado"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^S-[0-9]+$" },
              "texto": { "type": "string" },
              "origen": { "$ref": "#/definitions/origen" },
              "estado": { "enum": ["propuesto", "confirmado", "rechazado"] }
            }
          }
        },
        "riesgos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "descripcion", "impacto", "mitigacion"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^RIS-[0-9]+$" },
              "descripcion": { "type": "string" },
              "impacto": { "enum": ["alto", "medio", "bajo"] },
              "mitigacion": { "type": "string" }
            }
          }
        }
      }
    },
    "contrato": {
      "type": "object",
      "required": ["frase"],
      "additionalProperties": false,
      "properties": {
        "frase": { "type": "string", "description": "Cuando [situación], [quién] necesita [hacer qué] para [resultado medible]." },
        "exito": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ],
          "description": "El número (o números) que se mirarán para saber que funcionó."
        }
      }
    },
    "actores": {
      "type": "array",
      "items": {
        "type": "object", "required": ["nombre"], "additionalProperties": false,
        "properties": {
          "nombre": { "type": "string" },
          "rol": { "type": "string" },
          "miembros": { "type": "array", "items": { "type": "string" }, "description": "Para actores colectivos." }
        }
      }
    },
    "glosario": {
      "type": "array",
      "items": {
        "type": "object", "required": ["termino", "significado"], "additionalProperties": false,
        "properties": { "termino": { "type": "string" }, "significado": { "type": "string" } }
      }
    },
    "estructura_organizativa": {
      "type": "array",
      "description": "Unidades organizativas del negocio: sedes, oficinas, franquicias, distribuidores.",
      "items": {
        "type": "object", "required": ["id", "nombre", "tipo"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^U-[0-9]+$" },
          "nombre": { "type": "string" },
          "tipo": { "enum": ["sede", "oficina", "franquicia", "distribuidor", "filial", "representacion"] },
          "ubicacion": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "pais": { "type": "string" },
              "ciudad": { "type": "string" },
              "zona_horaria": { "type": "string" }
            }
          },
          "reporta_a": { "type": "string", "pattern": "^U-[0-9]+$", "description": "ID de la unidad de la que reporta." },
          "depende_de": { "type": "array", "items": { "type": "string", "pattern": "^U-[0-9]+$" } },
          "estado": { "enum": ["proyectada", "abierta", "cerrada", "reorganizando"] },
          "origen": { "$ref": "#/definitions/origen" }
        }
      }
    },
    "flujos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titulo", "momento", "pasos"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "titulo": { "type": "string" },
          "momento": { "enum": ["hoy", "futuro"] },
          "origen": { "$ref": "#/definitions/origen" },
          "descripcion": { "type": "string" },
          "pasos": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/paso" } }
        }
      }
    },
    "acciones": {
      "type": "array",
      "description": "El orden del array ES el orden de ejecución. Cada acción tiene un objetivo, un responsable, un entregable y una fecha prevista.",
      "items": {
        "type": "object",
        "required": ["id", "nombre", "objetivo", "responsable"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^A-[0-9]+$" },
          "nombre": { "type": "string" },
          "descripcion": { "type": "string" },
          "objetivo": { "type": "string" },
          "responsable": { "type": "string", "description": "Actor o rol responsable de ejecutar la acción." },
          "entregable": { "type": "string", "pattern": "^ENT-[0-9]+$", "description": "ID del entregable que produce esta acción." },
          "fecha_prevista": { "type": "string", "description": "Formato ISO: YYYY-MM-DD." },
          "secuencia": {
            "type": "array",
            "items": { "type": "string", "pattern": "^A-[0-9]+$" },
            "description": "Ids de acciones que deben ejecutarse después de esta."
          },
          "origen": { "$ref": "#/definitions/origen" },
          "avance": { "$ref": "#/definitions/avance" }
        }
      }
    },
    "entregables": {
      "type": "array",
      "description": "Los documentos, certificados, contratos u otros resultados que produce el proyecto. Cada uno tiene criterios de aprobación.",
      "items": {
        "type": "object",
        "required": ["id", "nombre", "tipo"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ENT-[0-9]+$" },
          "nombre": { "type": "string" },
          "descripcion": { "type": "string" },
          "tipo": { "enum": ["documento", "certificado", "contrato", "acta", "registro", "plan", "manual", "matriz", "informe", "autorizacion"] },
          "acciones": {
            "type": "array",
            "items": { "type": "string", "pattern": "^A-[0-9]+$" },
            "description": "Ids de acciones que producen este entregable."
          },
          "fecha_prevista": { "type": "string" },
          "entregado_el": { "type": "string" },
          "origen": { "$ref": "#/definitions/origen" },
          "criterios_aprobacion": {
            "type": "array",
            "items": {
              "type": "object", "required": ["id", "condicion", "entregable"], "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^C-[0-9]+$" },
                "condicion": { "type": "string", "description": "Dado X, cuando Y → se cumple el criterio." },
                "entregable": { "type": "string", "pattern": "^ENT-[0-9]+$", "description": "Entregable que este criterio verifica." }
              }
            }
          },
          "avance": { "$ref": "#/definitions/avance" }
        }
      }
    },
    "normas": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "nombre"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^G-[0-9]+$" },
          "nombre": { "type": "string" },
          "descripcion": { "type": "string" },
          "tabla": {
            "type": "object", "required": ["columnas", "filas"], "additionalProperties": false,
            "description": "Tabla de decisión: la última columna es qué pasa; las demás son condiciones. Cada fila debe tener tantas celdas como columnas. El comodín 'cualquier valor' se escribe '*'.",
            "properties": {
              "columnas": { "type": "array", "items": { "type": "string" } },
              "filas": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
            }
          }
        }
      }
    },
    "estados": {
      "type": "array",
      "items": {
        "type": "object", "required": ["entidad", "estados"], "additionalProperties": false,
        "properties": {
          "entidad": { "type": "string" },
          "estados": {
            "type": "array",
            "items": {
              "type": "object", "required": ["nombre"], "additionalProperties": false,
              "properties": {
                "nombre": { "type": "string" },
                "acciones": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "type": "object", "required": ["accion"], "additionalProperties": false,
                        "properties": {
                          "accion": { "type": "string" },
                          "quien": { "type": "string" },
                          "pasa_a": { "type": "string" }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "datos": {
      "type": "array",
      "items": {
        "type": "object", "required": ["cosa"], "additionalProperties": false,
        "properties": {
          "cosa": { "type": "string" },
          "guarda": { "type": "array", "items": { "type": "string" } },
          "origen": { "type": "string", "description": "De dónde viene lo existente o 'se empieza de cero'." }
        }
      }
    },
    "metricas": {
      "type": "array",
      "description": "Los números de escala del negocio: cuántos empleados, registros, frecuencias.",
      "items": {
        "type": "object", "required": ["que", "cuanto"], "additionalProperties": false,
        "properties": { "que": { "type": "string" }, "cuanto": { "type": "string" } }
      }
    },
    "cumplimiento": {
      "type": "array",
      "description": "Requisitos legales, fiscales y laborales por jurisdicción.",
      "items": {
        "type": "object", "required": ["jurisdiccion"], "additionalProperties": false,
        "properties": {
          "jurisdiccion": { "type": "string", "description": "País o región: 'España', 'Portugal', 'California'." },
          "laboral": {
            "type": "array",
            "items": {
              "type": "object", "required": ["requisito"], "additionalProperties": false,
              "properties": {
                "requisito": { "type": "string" },
                "descripcion": { "type": "string" },
                "plazo": { "type": "string" },
                "responsable": { "type": "string" },
                "estado": { "enum": ["pendiente", "en proceso", "cumplido", "no aplicable"] }
              }
            }
          },
          "fiscal": {
            "type": "array",
            "items": {
              "type": "object", "required": ["requisito"], "additionalProperties": false,
              "properties": {
                "requisito": { "type": "string" },
                "descripcion": { "type": "string" },
                "plazo": { "type": "string" },
                "responsable": { "type": "string" },
                "estado": { "enum": ["pendiente", "en proceso", "cumplido", "no aplicable"] }
              }
            }
          },
          "licencias": {
            "type": "array",
            "items": {
              "type": "object", "required": ["requisito"], "additionalProperties": false,
              "properties": {
                "requisito": { "type": "string" },
                "descripcion": { "type": "string" },
                "plazo": { "type": "string" },
                "responsable": { "type": "string" },
                "estado": { "enum": ["pendiente", "en proceso", "cumplido", "no aplicable"] }
              }
            }
          },
          "origen": { "$ref": "#/definitions/origen" }
        }
      }
    },
    "presupuesto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moneda": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object", "required": ["nombre", "categoria", "importe_estimado"], "additionalProperties": false,
            "properties": {
              "nombre": { "type": "string" },
              "categoria": { "enum": ["infraestructura", "personal", "legal", "marketing", "operaciones", "tecnologia", "formacion", "contingencia"] },
              "importe_estimado": { "type": "number" },
              "periodicidad": { "type": "string", "description": "puntual | mensual | anual." },
              "responsable": { "type": "string" }
            }
          }
        },
        "total_estimado": { "type": "number" },
        "origen": { "$ref": "#/definitions/origen" }
      }
    },
    "proveedores": {
      "type": "array",
      "description": "Gestorías, asesores, plataformas externas que apoyan el proyecto.",
      "items": {
        "type": "object", "required": ["nombre", "servicio"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^PROV-[0-9]+$" },
          "nombre": { "type": "string" },
          "servicio": { "type": "string" },
          "tipo": { "enum": ["gestoria", "asesoria", "plataforma", "consultoria", "operador", "otro"] },
          "contacto": { "type": "string" },
          "coste_estimado": { "type": "number" },
          "periodicidad": { "type": "string" }
        }
      }
    },
    "distribucion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entregas": {
          "type": "array",
          "description": "Quién recibe qué entregable, por qué canal y cuándo.",
          "items": {
            "type": "object", "required": ["entregable", "quien"], "additionalProperties": false,
            "properties": {
              "entregable": { "type": "string", "pattern": "^ENT-[0-9]+$" },
              "quien": { "type": "string" },
              "canal": { "type": "string" },
              "cuando": { "type": "string" }
            }
          }
        },
        "permisos": {
          "type": "object", "required": ["acciones", "roles"], "additionalProperties": false,
          "properties": {
            "acciones": { "type": "array", "items": { "type": "string" } },
            "roles": {
              "type": "array",
              "items": {
                "type": "object", "required": ["rol", "permitidas"], "additionalProperties": false,
                "properties": {
                  "rol": { "type": "string" },
                  "permitidas": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "avisos": {
          "type": "array",
          "items": {
            "type": "object", "required": ["quien", "que"], "additionalProperties": false,
            "properties": {
              "quien": { "type": "string" }, "que": { "type": "string" },
              "canal": { "type": "string" },
              "cuando": { "type": "string" }
            }
          }
        },
        "condiciones": { "type": "array", "items": { "type": "string" } }
      }
    },
    "calidad": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "criterio"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[0-9]+$" },
          "criterio": { "type": "string" }
        }
      }
    },
    "antecedentes": {
      "type": "array",
      "description": "Contexto histórico relevante para la planificación.",
      "items": {
        "type": "object", "required": ["texto"], "additionalProperties": false,
        "properties": {
          "texto": { "type": "string" },
          "refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "fuera": { "type": "array", "items": { "type": "string" } },
    "preguntas": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "origen": {
      "enum": ["usuario", "documentacion", "inferido", "mixto"],
      "description": "De dónde procede esta afirmación. El usuario manda sobre el diseño futuro; la documentación es el respaldo."
    },
    "avance": {
      "type": "object",
      "required": ["estado"],
      "additionalProperties": false,
      "properties": {
        "estado": { "enum": ["pendiente", "en progreso", "completado", "cancelado"] },
        "entregado_el": { "type": "string", "description": "Fecha de entrega (ISO: YYYY-MM-DD)." },
        "evidencia": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object", "required": ["tipo", "referencia"], "additionalProperties": false,
                "properties": {
                  "tipo": { "enum": ["documento", "certificado", "contrato", "acta", "informe"] },
                  "referencia": { "type": "string" },
                  "detalle": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "paso": {
      "oneOf": [
        { "$ref": "#/definitions/accion_paso" },
        { "$ref": "#/definitions/decision" }
      ]
    },
    "accion_paso": {
      "type": "object", "required": ["tipo", "texto"], "additionalProperties": false,
      "properties": {
        "tipo": { "enum": ["humano", "automatizado", "externo"], "description": "externo = lo hace un tercero fuera del proceso (el banco, la gestora)." },
        "texto": { "type": "string", "minLength": 1 },
        "quien": { "type": "string" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["tipo", "clase", "condicion"],
      "additionalProperties": false,
      "oneOf": [ { "required": ["rama"] }, { "required": ["ramas"] } ],
      "properties": {
        "tipo": { "const": "decision" },
        "clase": { "enum": ["regla", "excepcion"] },
        "condicion": { "type": "string", "minLength": 1 },
        "quien": { "type": "string", "description": "Quién evalúa la condición, si la decide una persona." },
        "rama": { "$ref": "#/definitions/rama" },
        "ramas": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/rama" } },
        "sigue": { "type": "string", "description": "Etiqueta del camino normal." }
      }
    },
    "rama": {
      "type": "object", "required": ["etiqueta", "pasos"], "additionalProperties": false,
      "properties": {
        "etiqueta": { "type": "string", "minLength": 1 },
        "pasos": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/paso" } },
        "termina": { "type": "boolean", "description": "true = este camino TERMINA aquí." }
      }
    }
  }
}
